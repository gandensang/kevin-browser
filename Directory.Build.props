<Project>

  <!-- Setelan untuk SEMUA proyek di solution ini. Yang khusus satu proyek
       tetap di .csproj-nya. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- .NET tidak perlu data budaya/ICU sendiri; WebKit memuat ICU-nya
         sendiri untuk halaman web. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Versi paket .deb (scripts/buat-deb.sh). Naikkan setiap membuat paket
         baru: apt hanya memperbarui ke versi yang lebih tinggi. -->
    <Version>0.1.6</Version>
  </PropertyGroup>

</Project>
